<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Jellyfin-TV-Client: keine Anmeldedaten sichern. authentication_store.json enthält die Tokens
             der Profile, die Benutzereinstellungen u. a. den Jellyseerr-API-Schlüssel – beides bleibt auf
             dem Gerät. Gesichert werden nur unkritische Einstellungen (Dateiname mit .xml). -->
        <include
            domain="sharedpref"
            path="systemprefs.xml" />
        <include
            domain="sharedpref"
            path="authentication.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Jellyfin-TV-Client: keine Anmeldedaten sichern. authentication_store.json enthält die Tokens
             der Profile, die Benutzereinstellungen u. a. den Jellyseerr-API-Schlüssel – beides bleibt auf
             dem Gerät. Gesichert werden nur unkritische Einstellungen (Dateiname mit .xml). -->
        <include
            domain="sharedpref"
            path="systemprefs.xml" />
        <include
            domain="sharedpref"
            path="authentication.xml" />
    </device-transfer>
</data-extraction-rules>
